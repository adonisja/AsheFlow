<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asheflow.docsbackup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akkeem/Documents/ClassAssignments/GitHub_Projects/AsheFlow/scripts/backup_docs_vault.sh</string>
    </array>

    <!-- Daily at 13:00. RunAtLoad catches up if the machine was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>13</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/asheflow-docsbackup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/asheflow-docsbackup.err</string>
</dict>
</plist>

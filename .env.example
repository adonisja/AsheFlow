# ============================================================
# AsheFlow — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=asheflow
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=asheflow_db

# DATABASE_URL is built from the above in docker-compose.
# Override here if you're using an external PG instance.
# DATABASE_URL=postgresql://asheflow:CHANGE_ME@localhost:5432/asheflow_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Application secrets ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# Shared secret between backend and the Discord bot for internal webhooks.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=CHANGE_ME_generate_a_real_internal_secret

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=CHANGE_ME

# Channel ID where final driver assignments are posted
DISCORD_DRIVERS_CHANNEL_ID=

# --- AWS Cognito (authentication) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# --- Environment ---
ENVIRONMENT=development

# AsheFlow Mobile — PRODUCTION build config
# Before building for App Store / Play Store:
#   cp .env.production.example .env
# Then run: npx react-native run-android --mode=release
#            or build via Xcode / EAS Build
#
# Real values are stored in GitHub Actions secrets. Contact a project
# maintainer to get the values for local builds.

ASHEFLOW_API_URL=https://api.asheflow.com/api/v1

COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

COGNITO_OAUTH_DOMAIN=your-app-auth.auth.us-east-2.amazoncognito.com
COGNITO_REDIRECT_URI=asheflow://callback

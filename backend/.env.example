# ============================================================
# AsheFlow backend — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Environment ---
# development | test | staging | production
# In production and staging: INTERNAL_SECRET and CORS_ORIGINS guards fire at startup.
APP_ENV=development

# --- PostgreSQL ---
# In Docker Compose, DATABASE_URL is injected by docker-compose.yml from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Override here only when connecting to an external database (e.g. RDS).
# DATABASE_URL=postgresql://asheflow:CHANGE_ME@localhost:5432/asheflow_db

# --- Redis ---
# In Docker Compose, the redis service is reachable at redis://redis:6379/0.
# Override when using ElastiCache or an external Redis instance.
REDIS_URL=redis://redis:6379/0

# --- Application secrets ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# INTERNAL_SECRET is required to be non-default in all non-development environments.
INTERNAL_SECRET=CHANGE_ME_generate_a_real_internal_secret

# --- Credential encryption (REQUIRED — the app will not start without it) ---
# Fernet key for encrypting trainee credentials (flex email, clock-in code).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_a_real_fernet_key

# --- Discord bot communication ---
# URL the backend calls to reach the bot service.
# Must be in _ALLOWED_BOT_HOSTS: {"bot", "localhost", "127.0.0.1"}
BOT_INTERNAL_URL=http://bot:8001

# --- AWS (Cognito + SES) ---
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# SES verified sender identity. Must match a verified address or domain in SES.
SES_FROM_EMAIL=AsheFlow <noreply@asheflow.com>

# --- Web app base URL ---
# Used to build invite links in registration emails.
# In production: https://asheflow.com
APP_BASE_URL=http://localhost:5173

# --- CORS ---
# Comma-separated list of allowed origins.
# In production: set to your actual domain(s).
# The app will refuse to start in non-dev/non-test environments if localhost is present.
# Example production value:
# CORS_ORIGINS=https://asheflow.com,https://www.asheflow.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- NYC GeoClient v2 (manifest address enrichment) ---
# Register at https://api.nyc.gov/ (free account required).
# v2 uses subscription-key only — no app_id needed.
# Leave blank in development to skip geocoding (addresses will still parse
# block_key from raw strings; lat/lng falls back to Amazon-supplied coords).
GEOCLIENT_APP_KEY=

# --- CloudWatch (production only) ---
# Required when running docker-compose.prod.yml.
# CLOUDWATCH_LOG_GROUP=/asheflow/production
# AWS_DEFAULT_REGION=us-east-1

# --- ORE completion certificates (ADR-281) ---
# S3 bucket + KMS key for phase-0 training certificates. Retention is 48h; the
# attestation on the training record is permanent, the file is not.
# Leave BLANK to disable: uploads then return 503 with a clear message rather
# than erroring, which is the intended degradation path.
# Staging: asheflow-ore-certificates-staging   Prod: asheflow-ore-certificates-prod
ORE_CERTIFICATE_BUCKET=
ORE_CERTIFICATE_KMS_KEY_ID=

{
  "Role": "arn:aws:iam::586794453404:role/asheflow-s3-replication",
  "Rules": [
    {
      "ID": "replicate-all-backups-to-us-west-2",
      "Priority": 1,
      "Status": "Enabled",
      "Filter": {},
      "DeleteMarkerReplication": { "Status": "Disabled" },
      "Destination": {
        "Bucket": "arn:aws:s3:::asheflow-db-backups-dr",
        "StorageClass": "STANDARD_IA"
      }
    },
    {
      "ID": "replicate-all-backups-to-locked-vault",
      "Priority": 2,
      "Status": "Enabled",
      "Filter": {},
      "DeleteMarkerReplication": { "Status": "Disabled" },
      "Destination": {
        "Bucket": "arn:aws:s3:::asheflow-db-backups-locked",
        "StorageClass": "STANDARD_IA"
      }
    }
  ]
}

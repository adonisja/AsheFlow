{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAsheFlowParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:us-east-2:586794453404:parameter/asheflow/staging/*"
    },
    {
      "Sid": "DecryptSecureStrings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-2:586794453404:key/alias/aws/ssm"
    }
  ]
}

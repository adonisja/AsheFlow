{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperatorsWithMFA",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::586794453404:user/asheflow-dev",
          "arn:aws:iam::586794453404:root"
        ]
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}

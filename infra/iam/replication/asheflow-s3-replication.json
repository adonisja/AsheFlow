{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceForReplication",
      "Effect": "Allow",
      "Action": [
        "s3:GetReplicationConfiguration",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::asheflow-db-backups"
    },
    {
      "Sid": "ReadSourceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersionForReplication",
        "s3:GetObjectVersionAcl",
        "s3:GetObjectVersionTagging"
      ],
      "Resource": "arn:aws:s3:::asheflow-db-backups/*"
    },
    {
      "Sid": "WriteReplicaOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ReplicateObject",
        "s3:ReplicateTags",
        "s3:ObjectOwnerOverrideToBucketOwner"
      ],
      "Resource": [
        "arn:aws:s3:::asheflow-db-backups-dr/*",
        "arn:aws:s3:::asheflow-db-backups-locked/*"
      ]
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyProdBoxWritesProdPrefix",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::asheflow-db-backups/prod/*",
      "Condition": {
        "StringNotLike": {
          "aws:userid": "*:i-095bf2ed310c86741"
        }
      }
    },
    {
      "Sid": "OnlyStagingBoxWritesStagingPrefix",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::asheflow-db-backups/staging/*",
      "Condition": {
        "StringNotLike": {
          "aws:userid": "*:i-0adb5030b967854b2"
        }
      }
    }
  ]
}
